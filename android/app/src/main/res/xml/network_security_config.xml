<?xml version="1.0" encoding="utf-8"?>
<!--
  Raid OS talks to its server over HTTPS only (https://raidos.app). The page is served from https://localhost inside
  the app, so plain HTTP calls are blocked as mixed content anyway; plain HTTP is refused here too, except to the phone
  itself and the emulator's host, for development. A development build against a server in the home network
  (http://192.168.x.x:8787, RAIDOS_MOBILE_DEV_HTTP=1, docs/mobile.md) lists that address in the domain-config below.
  User-installed CAs are not trusted: a certificate added on the phone cannot read the app's traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android emulator alias for the host PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
