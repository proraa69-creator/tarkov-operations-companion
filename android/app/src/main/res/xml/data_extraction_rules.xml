<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (AndroidManifest.xml android:dataExtractionRules): nothing of the app's data goes into a cloud backup or a
  device-to-device transfer. The WebView storage holds the account session token (src/sync/webAccount.ts); a new phone
  signs in again (QR sign-in, docs/mobile.md). Older Android: android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
